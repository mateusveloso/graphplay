# Any provider supported by LangChain's init_chat_model, as "provider:model".
TRIAGE_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional. Unauthenticated GitHub calls are rate-limited and code search requires a token.
GITHUB_TOKEN=

# Loop limits are enforced in code, not in prompts.
TRIAGE_MAX_CRITIC_ROUNDS=2
TRIAGE_MAX_EVIDENCE=5
