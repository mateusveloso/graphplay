# One generative model per role, as "provider:model" (anything init_chat_model accepts).
# Planning is bounded: small model. Writing and judging: big model.
TRIAGE_MODEL_PLANNER=anthropic:claude-haiku-5-5
TRIAGE_MODEL_WRITER=anthropic:claude-opus-5-5
TRIAGE_MODEL_CRITIC=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Decision model (TypeSafe AI System One, "Jev"). Optional: without it the graph
# takes the full generative path on every decision.
TYPESAFE_API_KEY=

# Optional. Unauthenticated GitHub calls are rate-limited and code search requires a token.
GITHUB_TOKEN=

# Loop limits and thresholds are enforced in code, not in prompts.
TRIAGE_MAX_CRITIC_ROUNDS=2
TRIAGE_MAX_EVIDENCE=5
TRIAGE_SKIP_CODE_BELOW=0.15   # P(needs code) at or below this: skip planner+collect
TRIAGE_RUBRIC_PASS=0.85       # every rule at or above this: skip the generative critic
TRIAGE_RUBRIC_FAIL=0.50       # any rule below this: reject with templated feedback
