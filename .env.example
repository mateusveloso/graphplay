# Which embedded world to play (see internal/world/worlds/).
PLAY_WORLD=cellar

# --- Generative models: one provider, one model per role ---------------------------
# Proposing candidate commands is bounded and cheap to get slightly wrong: small model.
# Solving a riddle is real reading: large model.

PLAY_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Defaults for deepseek; override if you want.
# PLAY_MODEL_PROPOSER=deepseek-flash
# PLAY_MODEL_SOLVER=deepseek-v4-pro

# Alternative: PLAY_PROVIDER=anthropic with ANTHROPIC_API_KEY (an sk-ant-api03-... key from
# console.anthropic.com; Claude Code OAuth tokens do not work with the API).
# ANTHROPIC_API_KEY=
# PLAY_MODEL_PROPOSER=claude-haiku-5-5
# PLAY_MODEL_SOLVER=claude-opus-5-5

# --- Decision model: TypeSafe AI System One ("Jev") ----------------------------------
# Optional. Without it every exit is treated as safe and code explores everything,
# dying, reloading and remembering as it goes.
TYPESAFE_API_KEY=

# --- Limits and thresholds, enforced in code, never in prompts ----------------------
PLAY_RISK_THRESHOLD=0.6        # P(lethal) at or above this: code will not explore that exit on its own
PLAY_MAX_TURNS=60              # hard stop
PLAY_MAX_DEATHS=3              # deaths before a human is asked
PLAY_STUCK_TURNS=8             # turns without progress before a human is asked
PLAY_MAX_RIDDLE_ATTEMPTS=3     # wrong answers before a human is asked

# Where checkpoints (save games) and reports go.
PLAY_STATE_DIR=.play
